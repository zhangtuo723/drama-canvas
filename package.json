{
  "name": "drama-canvas",
  "version": "0.2.0",
  "description": "Local image and video canvas controlled through a CLI and a Codex plugin",
  "type": "module",
  "bin": {
    "drama-canvas": "src/cli.js"
  },
  "files": [
    "src",
    "dist",
    "plugin",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "start": "node src/cli.js serve --project ./demo --port 4317",
    "test": "node --test",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write src web test package.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@xyflow/react": "^12.8.5",
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangtuo723/drama-canvas.git"
  },
  "homepage": "https://github.com/zhangtuo723/drama-canvas#readme",
  "bugs": {
    "url": "https://github.com/zhangtuo723/drama-canvas/issues"
  }
}
